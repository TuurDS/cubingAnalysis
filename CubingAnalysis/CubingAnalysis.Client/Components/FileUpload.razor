@using CubingAnalysis.Core.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IServiceProvider services

<div>
    <MudFileUpload T="IBrowserFile" Class="file-upload" OnFilesChanged="OnFileChange" MaxFileSize="maxFileSize">
        <ActivatorContent>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="file-upload-btn">
                Single File
            </MudButton>
        </ActivatorContent>
        <SelectedTemplate>
            @if (context != null)
            {
                <MudText>@context.Name</MudText>
            }
            else
            {
                <MudText>No File</MudText>
            }
        </SelectedTemplate>
    </MudFileUpload>

    @fileLines

</div>

@code {
    private long maxFileSize = 1073741824; // 1 GB
    private SessionState? sessionState;

    private long fileLines = 0;

    protected override void OnInitialized()
    {
        if (services.GetService<SessionState>() is { } service)
        {
            sessionState = service;
        }
    }

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        using var stream = file.OpenReadStream(maxFileSize);
        using var reader = new StreamReader(stream);

        var lines = new List<string>();
        string? line;
        while ((line = await reader.ReadLineAsync()) is not null)
        {
            lines.Add(line);
        }

        // For now, just store the content string in the SessionState.
        // Later you can replace this with actual parsing logic.
        sessionState!.Value = new List<object> { lines };
        Console.WriteLine("reached here");
        if (sessionState.Value.Count > 0)
        {
            var stateLines = sessionState.Value[0] as List<string>;
            if (stateLines != null)
            {
                int length = stateLines.Count;
				fileLines = length;
            }
        }

    }
}
