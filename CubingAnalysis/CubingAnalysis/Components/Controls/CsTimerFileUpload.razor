@using CubingAnalysis.Core.Parsing
@using CubingAnalysis.Core.Models.Config
@using CubingAnalysis.Core.Models.Parsing
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@inject AnalysisContextService analysisContextService

<div style="margin-top: 8px;">
    <MudFileUpload T="IBrowserFile"
                   Class="file-upload"
                   OnFilesChanged="OnFileChange"
                   MaxFileSize="maxFileSize">
        <ActivatorContent>
            <MudButton Disabled="@isLoading" Variant="Variant.Filled" Color="Color.Primary" Class="file-upload-btn">
                @if (isLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Processing</MudText>
                }
                else
                {
                    <MudText>Upload File Export</MudText>
                }
            </MudButton>
        </ActivatorContent>

        <SelectedTemplate>
            @if (context != null)
            {
                <MudText>@context.Name</MudText>
            }
            else
            {
                <MudText>There is no file selected</MudText>
            }
        </SelectedTemplate>
    </MudFileUpload>
</div>

@code {
    [Parameter] public bool isLoading { get; set; }
    [Parameter] public EventCallback<bool> isLoadingChanged { get; set; }

    private long maxFileSize = 1073741824; // 1 GB

    private async Task SetLoadingAsync(bool value)
    {
        isLoading = value;
        if (isLoadingChanged.HasDelegate)
            await isLoadingChanged.InvokeAsync(value);
    }

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        await SetLoadingAsync(true);

        // Fire-and-forget background task
        _ = Task.Run(async () =>
        {
            try
            {
                using var stream = file.OpenReadStream(maxFileSize);
                using var doc = await JsonDocument.ParseAsync(stream);
                var parsedSessions = CsTimerParser.ParseTimerExport(doc);

                // Invoke UI updates on the UI thread
                await InvokeAsync(async () =>
                {
                    analysisContextService.Set<List<Session>>(AnalysisContextProperty.SessionData, parsedSessions);
                    await SetLoadingAsync(false);
                });
            }
            catch
            {
                await InvokeAsync(async () => await SetLoadingAsync(false));
            }
        });
    }

}
